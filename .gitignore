# --- Dependencias de Node.js ---
node_modules/

# --- Archivos JavaScript compilados desde TypeScript ---
*.js
*.js.map

# --- Carpeta de salida de compilación (si se configura una) ---
dist/
build/
out/

# --- Logs y archivos temporales ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Configuración local de editores ---
.vscode/
.idea/
*.swp

# --- Archivos del sistema operativo ---
.DS_Store        # macOS
Thumbs.db        # Windows

# --- Variables de entorno (nunca subir credenciales) ---
.env
.env.local