      "name": "Query - Continentes con países",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"No hay errores GraphQL en la respuesta\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.not.have.property(\"errors\");\r",
              "});\r",
              "\r",
              "pm.test(\"Se retornan exactamente 7 continentes\", function () {\r",
              "    const continents = pm.response.json().data.continents;\r",
              "    pm.expect(continents).to.be.an(\"array\");\r",
              "    pm.expect(continents.length).to.equal(7);\r",
              "});\r",
              "\r",
              "pm.test(\"Cada continente tiene países anidados\", function () {\r",
              "    const continents = pm.response.json().data.continents;\r",
              "    continents.forEach(function(continent) {\r",
              "        pm.expect(continent).to.have.property(\"countries\");\r",
              "        pm.expect(continent.countries).to.be.an(\"array\");\r",
              "        pm.expect(continent.countries.length).to.be.greaterThan(0);\r",
              "    });\r",
              "});"
            ],
