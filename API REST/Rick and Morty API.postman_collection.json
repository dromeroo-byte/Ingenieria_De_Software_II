          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"El personaje tiene nombre y status\", function () {\r",
              "    const character = pm.response.json();\r",
              "    pm.expect(character).to.have.property(\"name\");\r",
              "    pm.expect(character).to.have.property(\"status\");\r",
              "    pm.expect(character.name).to.equal(\"Rick Sanchez\");\r",
              "});"
